# Admin panel – required
SESSION_SECRET=

# Option A: Password login (generate hash: node scripts/hash-password.js "YourPassword")
ADMIN_PASSWORD_HASH=

# Option B: Google login (create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for Google login: only these emails can access admin (comma-separated). No one can log in until you set this.
ALLOWED_ADMIN_EMAILS=inigouriartepena@gmail.com

# Optional: base URL for OAuth redirect (default http://localhost:3000). Set in production.
# BASE_URL=https://your-admin.example.com
# Optional: port (default 3000)
# PORT=3000
