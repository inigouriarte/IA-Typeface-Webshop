# Admin panel – Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Base URL for auth callbacks (defaults to http://localhost:3000)
# BETTER_AUTH_URL=https://alphabets.indigoindigo.org

# Turso database (production). Omit for local SQLite file fallback.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Optional: port (default 3000)
# PORT=3000

# Stripe (for font purchases)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
