  "alvica": {
    "description": "Swiss-knife (you get it?), everyday use, highly versatile, all-in-one typographic family. INDG Alvica counters its sober appearance with a broad set of quirky alternates.",
    "details": {
      "designer": "Iñigo Uriarte",
      "version": "1.0",
